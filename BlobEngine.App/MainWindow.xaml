<Window x:Class="BlobEngine.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BlobEngine" Height="850" Width="1450" MinHeight="720" MinWidth="1050" Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
<Window.Resources><Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/></Style></Window.Resources>
<Grid Margin="5"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="70"/><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="112"/><RowDefinition Height="48"/></Grid.RowDefinitions>
<!-- Header -->
<Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="14,14,0,0" Padding="28,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,1,1,0"><DockPanel LastChildFill="True"><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="12" Background="#5425A8" VerticalAlignment="Center"><TextBlock Text="B" Foreground="#E8D7FF" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/></Border><TextBlock Text="BlobEngine" FontSize="27" FontWeight="SemiBold" Margin="16,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="Файл" Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="15,8" Click="RefreshProcesses_Click"/><Button Content="Настройки" Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="15,8" Click="Settings_Click"/><Button Content="Помощь" Background="Transparent" Foreground="{StaticResource TextBrush}" Padding="15,8" Click="Help_Click"/></StackPanel></DockPanel></Border>
<!-- Settings strip -->
<Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="28,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="⚙  НАСТРОЙКИ" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,26,0"/><TextBlock Grid.Column="1" Text="Язык" Margin="0,0,10,0"/><ComboBox Grid.Column="2" Width="130" SelectedIndex="0"><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/></ComboBox><Border Grid.Column="3" Width="1" Background="{StaticResource LineBrush}" Margin="24,6"/><StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Тема" Margin="0,0,10,0"/><ComboBox Width="125" SelectedIndex="0"><ComboBoxItem Content="Тёмная"/><ComboBoxItem Content="Серая"/></ComboBox><TextBlock Text="Автосохранение" Margin="32,0,10,0"/><CheckBox IsChecked="True" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="🎮  Выбор игры:" Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="ProcessBox" Width="260" DisplayMemberPath="Display" SelectionChanged="ProcessBox_SelectionChanged"/></StackPanel></Grid></Border>
<!-- Search -->
<Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="28,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions><Border Background="{StaticResource FieldBrush}" BorderBrush="#5A4B82" BorderThickness="1.5" CornerRadius="10" Padding="14,0"><DockPanel><TextBlock Text="⌕" FontSize="32" Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0"/><TextBox x:Name="SearchBox" Text="100" FontSize="20" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" ToolTip="Введи точное числовое значение, например 100 или 250.5"/></DockPanel></Border><Button Grid.Column="1" Content="Найти" Margin="18,0,0,0" FontSize="18" Click="Search_Click"/></Grid></Border>
<!-- Results -->
<Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="24,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0"><DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="1.5*"/></DataGrid.Columns></DataGrid></Border>
<!-- Value editor -->
<Border Grid.Row="4" Background="{StaticResource PanelBrush}" Padding="28,16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="Новое значение:" FontSize="17" Margin="0,0,18,0"/><TextBox x:Name="NewValueBox" Grid.Column="1" Text="10000" FontSize="18" VerticalContentAlignment="Center"/><TextBlock Grid.Column="2" Text="Тип:" FontSize="17" Margin="24,0,14,0"/><ComboBox x:Name="ValueTypeBox" Grid.Column="3" SelectedIndex="0"><ComboBoxItem Content="4 байта"/><ComboBoxItem Content="8 байт"/><ComboBoxItem Content="Float"/><ComboBoxItem Content="Double"/></ComboBox><Button Grid.Column="5" Content="⚡  Изменить" FontSize="18" Click="Change_Click"/></Grid></Border>
<!-- Status -->
<Border Grid.Row="5" Background="{StaticResource PanelBrush}" CornerRadius="0,0,14,14" Padding="28,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,1,1"><DockPanel><Ellipse Width="13" Height="13" Fill="#22C55E" Margin="0,0,14,0"/><TextBlock x:Name="FooterText" Text="Готов к работе" Foreground="{StaticResource MutedBrush}" FontSize="15"/><TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Не подключено" Foreground="{StaticResource MutedBrush}"/></DockPanel></Border>
</Grid></Window>