<Window x:Class="BlobEngine.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BlobEngine" Height="780" Width="1280" MinHeight="650" MinWidth="980" Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
<Grid Margin="5"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="78"/><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="100"/><RowDefinition Height="42"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="14,14,0,0" Padding="26,0"><DockPanel><TextBlock Text="B" FontSize="42" FontWeight="Bold" Foreground="#A34BFF" Margin="0,0,24,0"/><TextBlock Text="BlobEngine" FontSize="28" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="Файл" Margin="4" Click="RefreshProcesses_Click"/><Button Content="Настройки" Margin="4" Click="Settings_Click"/><Button Content="Помощь" Margin="4" Click="Help_Click"/></StackPanel></DockPanel></Border>
<Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="26,10"><DockPanel><TextBlock Text="ИГРА / ПРОЦЕСС" Foreground="{StaticResource MutedBrush}" Margin="0,0,18,0"/><ComboBox x:Name="ProcessBox" Width="360" DisplayMemberPath="Display" SelectionChanged="ProcessBox_SelectionChanged"/><Button Content="Обновить список" Margin="12,0" Click="RefreshProcesses_Click"/><TextBlock x:Name="StatusText" Text="Не подключено" Foreground="{StaticResource MutedBrush}" Margin="24,0"/></DockPanel></Border>
<Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="26,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Text="деньги" FontSize="20" VerticalContentAlignment="Center" ToolTip="Название параметра: деньги, здоровье, патроны..."/><Button Grid.Column="1" Content="Найти" Margin="14,0,0,0" Click="Search_Click"/></Grid></Border>
<Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="24,12"><DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" Background="#151522" Foreground="{StaticResource TextBrush}" RowBackground="#191927" AlternatingRowBackground="#211E35" GridLinesVisibility="Horizontal" BorderBrush="#39334F" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="2*"/></DataGrid.Columns></DataGrid></Border>
<Border Grid.Row="4" Background="{StaticResource PanelBrush}" Padding="24,10"><DockPanel><Button DockPanel.Dock="Right" Content="⚡ Изменить" Width="180" Click="Change_Click"/><ComboBox x:Name="ValueTypeBox" DockPanel.Dock="Right" Width="145" SelectedIndex="0" Margin="12,0"><ComboBoxItem Content="4 байта"/><ComboBoxItem Content="8 байт"/><ComboBoxItem Content="Float"/><ComboBoxItem Content="Double"/></ComboBox><TextBlock DockPanel.Dock="Right" Text="Тип:" Margin="10,0"/><TextBox x:Name="NewValueBox" DockPanel.Dock="Right" Width="180" Text="10000" Margin="0,0,10,0"/><TextBlock DockPanel.Dock="Left" Text="Новое значение:" FontSize="17" Margin="0,0,18,0"/></DockPanel></Border>
<Border Grid.Row="5" Background="{StaticResource PanelBrush}" CornerRadius="0,0,14,14" Padding="24,0"><DockPanel><Ellipse Width="14" Height="14" Fill="#22C55E" Margin="0,0,14,0"/><TextBlock x:Name="FooterText" Text="Готов к работе" Foreground="{StaticResource MutedBrush}"/></DockPanel></Border>
</Grid></Window>